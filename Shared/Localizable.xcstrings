{
  "sourceLanguage": "en",
  "strings": {
    "%lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        }
      }
    },
    "%lld recordings · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条录音 · %@"
          }
        }
      }
    },
    "%lld–%lld bpm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld–%lld 次/分"
          }
        }
      }
    },
    "A summary appears after transcription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写完成后会生成摘要。"
          }
        }
      }
    },
    "AI Model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        }
      }
    },
    "Add an OpenAI-compatible endpoint and key to start chatting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个 OpenAI 兼容接口和 Key 即可开始对话。"
          }
        }
      }
    },
    "Allow microphone access in the Watch app settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在手表设置中允许麦克风访问。"
          }
        }
      }
    },
    "Answers come from your own recordings, with links to the moments they came from.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案来自你自己的录音，并附带对应时刻的链接。"
          }
        }
      }
    },
    "Any service compatible with the OpenAI Chat Completions API works, including self-hosted Ollama, vLLM or LM Studio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何兼容 OpenAI Chat Completions API 的服务都可以使用，包括自托管的 Ollama、vLLM 或 LM Studio。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问"
          }
        }
      }
    },
    "Ask Auday": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问 Auday"
          }
        }
      }
    },
    "Ask about your day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问你的一天"
          }
        }
      }
    },
    "Ask about your recordings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问你的录音内容…"
          }
        }
      }
    },
    "Ask anything about your day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于你的一天，尽管问"
          }
        }
      }
    },
    "Auday turns your Apple Watch into an all-day AI memory. Record, transcribe and ask about anything you heard.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Auday 把你的 Apple Watch 变成全天候的 AI 记忆。录音、转写，并随时询问你听到过的一切。"
          }
        }
      }
    },
    "Audio recordings, transcripts, health data, places and chat history are stored only on your iPhone. There is no Auday server or account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、转写、健康数据、地点和对话记录只保存在你的 iPhone 上。没有 Auday 服务器，也不需要账号。"
          }
        }
      }
    },
    "Audio storage": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频占用"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL"
          }
        }
