    "Connect an AI model in Settings to get summaries, daily reflections and chat.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中连接 AI 模型，即可获得摘要、每日回顾和对话。"
          }
        }
      }
    },
    "Connect an AI model in Settings to summarize recordings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中连接 AI 模型以总结录音。"
          }
        }
      }
    },
    "Connect an AI model in the iPhone app first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 iPhone App 中连接 AI 模型。"
